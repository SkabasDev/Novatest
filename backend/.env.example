PAYMENT_GATEWAY_PUBLIC_KEY=pub_sandbox_replace_me
PAYMENT_GATEWAY_PRIVATE_KEY=prv_sandbox_replace_me
PAYMENT_GATEWAY_EVENTS_KEY=events_sandbox_replace_me
PAYMENT_GATEWAY_INTEGRITY_KEY=integrity_sandbox_replace_me

# Checkout fees (in cents)
BASE_FEE_IN_CENTS=350000
